  "sabads": [
    {
      "id": 1,
      "title": "सबद - 1",
      "verses": [
        "ओ३म् गुरु चीन्हों गुरु चीन्ह पुरोहित। गुरु मुख धर्म बखाणीं।।",
        "जो गुरु होयबा सहजे शीले सबदे नादे वेदे तिहिं गुरु का आलिंगार पिछाणी।।",
        "छव दरशण जिहिं कै रूपण थापण, संसार बरतण निज कर थरप्या। सो गुरु प्रत्यक्ष जाणी।।"
      ],
      "wordCount": 142,
      "meaning": "भावार्थ: गुरु जंभेश्वर भगवान फरमाते हैं कि सच्चे सतगुरु की पहचान उनके आचरण, शील, शांत वाणी और वेदों/शब्दों के ज्ञान से होती है।"
    }
  ],
  "sakhis": [
    {
      "id": 1,
      "title": "साखी - 1",
      "verses": [
        "॥ साखी - 1 ॥",
        "गुरु जंभेश्वर उवाच - सत्य बचन साखी बखाणी।",
        "दया धर्म का मूल है, पाप मूल अभिमान।",
        "जस गावै सो अमर होय, पाखंड छाडो साच समाणी।।"
      ]
    }
  ],
